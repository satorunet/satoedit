<Project Sdk="Microsoft.NET.Sdk">
  <!-- satoEdit (Windows) のインストーラー: 中に配布用の zip を抱えた 1 つの exe。
       管理者の許可なしで、そのユーザーの %LOCALAPPDATA%\Programs\satoruEditor に入れる。
       スタートメニュー・デスクトップのショートカットと、「アプリ」一覧からのアンインストールを登録する -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>satoruEditorSetup</AssemblyName>
    <RootNamespace>SatoEditSetup</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Setup.cs" />
    <!-- 中身: package-installer.js が置く、アプリのフォルダをまとめた zip -->
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
